{
  "name": "av-employees-slides",
  "private": true,
  "description": "Local tooling for editing and previewing slides.md",
  "scripts": {
    "preview": "marp slides.md --preview --html",
    "build:html": "marp slides.md -o slides.html --html --allow-local-files",
    "build:pdf": "marp slides.md -o slides.pdf --pdf --allow-local-files",
    "build:pptx": "marp slides.md -o slides.pptx --pptx --allow-local-files"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.0.0"
  }
}
