av_employees:
  target: dev
  outputs:
    dev:
      type: snowflake
      account: <your_account>.<region>
      user: <username>
      password: <password>           # or use authenticator/private key
      role: <role>
      database: <database>
      warehouse: <warehouse>
      schema: dbt_<your_initials>    # personal dev schema
      threads: 4
    prod:
      type: snowflake
      account: <your_account>.<region>
      user: <prod_user>
      password: <prod_password>
      role: <prod_role>
      database: <database>
      warehouse: <warehouse>
      schema: analytics
      threads: 8
